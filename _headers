# _headers file for Netlify
/Build/*.br
  Content-Encoding: br
  Content-Type: application/octet-stream
  Content-Length: *

/Build/*.js.br
  Content-Encoding: br
  Content-Type: application/javascript
  Content-Length: *

/Build/*.wasm.br
  Content-Encoding: br
  Content-Type: application/wasm
  Content-Length: *

/Build/*.data.br
  Content-Encoding: br
  Content-Type: application/octet-stream
  Content-Length: *